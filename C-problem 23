#include <stdio.h>
int main()
{
    int a, f, s, t, sum, b, c, sum1, d, e, sum2;
    printf("Enter the three digit num: ");
    scanf("%d", &a);
    f = a % 10;
    s = (a / 10) % 10;
    t = a / 100;
    sum = f + s + t;
    if(sum < 10)
    {
        printf("%d\n", sum);
    }
    else
    {
        b = sum % 10;
        c = sum / 10;
        sum1 = b + c;
        if(sum1 < 10)
        {
            printf("%d\n", sum1);
        }
        else
        {
            d = sum1 % 10;
            e = sum1 / 10;
            sum2 = d + e;
            printf("%d\n", sum2);
        }
    }
}
